{
  "name": "alpha-video-gpu-web",
  "version": "1.0.0",
  "description": "Transparent (alpha) animations in a <canvas> from ASTC texture arrays in KTX2 files, drawn with WebGL 2, for plain JS/TS and React. Streams by range requests, with seeking and offline storage; the zstd decoder is bundled inline.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "module": "./dist/index.mjs",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "module": "./dist/react.mjs",
      "import": "./dist/react.mjs",
      "require": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "build:wasm": "wasm/build.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "keywords": [
    "ktx2",
    "astc",
    "texture-compression",
    "webgl",
    "webgl2",
    "canvas",
    "alpha",
    "alpha-video",
    "transparent-video",
    "transparent-animation",
    "transparency",
    "animation",
    "video-player",
    "zstd",
    "react"
  ],
  "author": "Daniel Kasprowicz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MediaCacheDev/alpha-video-gpu.git",
    "directory": "web"
  },
  "homepage": "https://github.com/MediaCacheDev/alpha-video-gpu#readme",
  "bugs": {
    "url": "https://github.com/MediaCacheDev/alpha-video-gpu/issues"
  },
  "peerDependencies": {
    "react": ">=16.8"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "alpha-video-source": "file:../../alpha-video-source/web",
    "react": "^18.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
