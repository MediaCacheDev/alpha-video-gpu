{
  "name": "react-native-alpha-video-gpu",
  "version": "1.0.1",
  "description": "Transparent (alpha) animations for React Native on Android, iOS and web, from ASTC texture arrays in KTX2 files. The GPU draws the frames as stored, with Metal, OpenGL ES or WebGL, so dozens play at once with little CPU.",
  "main": "react-native/src/index.js",
  "types": "react-native/src/index.d.ts",
  "files": [
    "react-native",
    "ios/Sources",
    "android/src",
    "third_party",
    "react-native.config.js",
    "react-native-alpha-video-gpu.podspec",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "!android/src/test",
    "!ios/Sources/AlphaVideoGPUSource",
    "!react-native/android/build",
    "!react-native/android/.gradle",
    "!react-native/android/.cxx",
    "!.DS_Store"
  ],
  "scripts": {
    "publish:android:local": "scripts/publish-android.sh local"
  },
  "codegenConfig": {
    "name": "RNAlphaVideoGpuSpec",
    "type": "components",
    "jsSrcsDir": "react-native/src",
    "android": {
      "javaPackageName": "dev.mediacache.alphavideo.gpu.reactnative"
    },
    "ios": {
      "componentProvider": {
        "AlphaVideoGpuView": "RNAlphaVideoGpuViewComponentView"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MediaCacheDev/alpha-video-gpu"
  },
  "homepage": "https://www.alpha-video.dev",
  "bugs": {
    "url": "https://github.com/MediaCacheDev/alpha-video-gpu/issues"
  },
  "keywords": [
    "react-native",
    "react-native-web",
    "react-native-component",
    "fabric",
    "alpha",
    "alpha-video",
    "transparent-video",
    "transparent-animation",
    "transparency",
    "animation",
    "video-player",
    "ktx2",
    "astc",
    "texture-compression",
    "gpu",
    "metal",
    "opengl-es",
    "webgl",
    "ios",
    "android",
    "web"
  ],
  "author": "Daniel Kasprowicz",
  "license": "MIT",
  "dependencies": {
    "alpha-video-gpu-web": "^1.0.0"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-native": ">=0.71.0"
  }
}
