{
  "name": "alpha-video-gpu",
  "version": "1.0.0",
  "description": "Transparent (alpha) animations for React Native as GPU-compressed KTX2 textures (ASTC / Basis Universal), drawn with Metal on iOS, OpenGL ES on Android and WebGL on the web.",
  "main": "react-native/src/index.js",
  "types": "react-native/src/index.d.ts",
  "files": [
    "react-native",
    "ios/Sources",
    "android/src",
    "third_party",
    "react-native.config.js",
    "react-native-alpha-video-gpu.podspec",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "!react-native/android/build",
    "!react-native/android/.gradle",
    "!react-native/android/.cxx",
    "!.DS_Store"
  ],
  "scripts": {
    "publish:android:local": "scripts/publish-android.sh local"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/danielkpl2/alpha-video-gpu"
  },
  "homepage": "https://github.com/danielkpl2/alpha-video-gpu#readme",
  "bugs": {
    "url": "https://github.com/danielkpl2/alpha-video-gpu/issues"
  },
  "keywords": [
    "react-native",
    "react-native-web",
    "alpha",
    "transparent-video",
    "transparency",
    "animation",
    "ktx2",
    "astc",
    "basis-universal",
    "metal",
    "opengl",
    "webgl",
    "ios",
    "android"
  ],
  "author": "Daniel Kasprowicz",
  "license": "MIT",
  "dependencies": {
    "alpha-video-gpu-web": "^1.0.0"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-native": ">=0.71.0"
  }
}
