{
  "name": "react-native-ktx2player",
  "version": "1.0.1",
  "description": "React Native module for playing KTX2 animated textures with GPU acceleration on iOS, Android, and Web",
  "main": "index.js",
  "types": "src/index.d.ts",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "bundle-basis": "node scripts/bundle-basis.js",
    "prepublishOnly": "npm run setup && npm run bundle-basis",
    "clean": "rm -rf vendor ios/vendor android/src/main/cpp/basis_universal",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "react-native",
    "react-native-web",
    "ktx2",
    "basis-universal",
    "animation",
    "texture",
    "sprite-sheet",
    "astc",
    "uastc",
    "gpu-texture",
    "metal",
    "opengl",
    "webgl"
  ],
  "author": "",
  "license": "MIT",
  "homepage": "https://github.com/user/react-native-ktx2player#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/user/react-native-ktx2player.git"
  },
  "bugs": {
    "url": "https://github.com/user/react-native-ktx2player/issues"
  },
  "exports": {
    ".": "./index.js",
    "./web": "./src/web/index.ts",
    "./standalone": "./standalone/index.ts",
    "./standalone/react": "./standalone/react.tsx"
  },
  "files": [
    "android/src/",
    "android/build.gradle",
    "ios/",
    "src/",
    "standalone/",
    "scripts/",
    "index.js",
    "react-native.config.js",
    "react-native-ktx2player.podspec",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-native": ">=0.60.0"
  },
  "peerDependenciesMeta": {
    "react-native-web": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "react": "^18.0.0",
    "react-native": "^0.72.0",
    "react-native-web": "^0.19.0",
    "typescript": "^5.0.0"
  }
}
